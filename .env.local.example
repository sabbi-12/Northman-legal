# Site
NEXT_PUBLIC_SITE_URL=https://northmansterling.legal

# Sanity CMS (Phase 3) — News & Updates content
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Only needed if the dataset is private or you read draft content —
# leave blank for a public dataset with published-only reads.
SANITY_API_TOKEN=
# Shared secret checked against the Sanity webhook payload so
# /api/revalidate can't be triggered by anyone else.
SANITY_REVALIDATE_SECRET=

# Contact form SMTP (Phase 3) — same pattern as Geosterling Systems.
# SMTP_HOST must resolve to the actual mail server IP, NOT a domain that
# points at Vercel — see the Geosterling contact-form fix for why.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@northmansterling.legal
SMTP_PASS=
CONTACT_TO_EMAIL=info@northmansterling.legal

# Analytics (Phase 4)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
